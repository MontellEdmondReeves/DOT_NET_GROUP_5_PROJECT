@page
@model Livestock_Health_App.Pages.Animals.IndexModel
@{
    ViewData["Title"] = Model.IsFarmer ? "My Animals" : "Find an Animal";

    string Age(DateTime? dob)
    {
        if (dob == null) return "—";
        var today = DateTime.Today;
        int months = (today.Year - dob.Value.Year) * 12 + today.Month - dob.Value.Month;
        if (today.Day < dob.Value.Day) months--;
        if (months < 0) months = 0;
        return months >= 12 ? $"{months / 12} yr {months % 12} mo" : $"{months} mo";
    }
}

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">
        @ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @err <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ======================= FARMER VIEW ======================= *@
@if (Model.IsFarmer)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">My Animals</h2>
        @if (Model.FarmOptions.Count > 0)
        {
            <button type="button" class="btn btn-primary" id="addAnimalBtn">+ Register animal</button>
        }
        else
        {
            <button type="button" class="btn btn-primary" disabled>+ Register animal</button>
        }
    </div>

    @if (Model.FarmOptions.Count == 0)
    {
        <div class="alert alert-info">
            You need to register a farm before you can add animals.
            <a asp-page="/Farms/Index">Go to My Farms</a>
        </div>
    }
    else
    {
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-4">
                <select name="FarmFilter" class="form-select">
                    <option value="0">All farms</option>
                    @foreach (var farm in Model.FarmOptions)
                    {
                        <option value="@farm.Value" selected="@(farm.Value == Model.FarmFilter.ToString())">@farm.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="SpeciesFilter" class="form-select">
                    <option value="">All species</option>
                    @foreach (var s in IndexModel.SpeciesList)
                    {
                        <option value="@s" selected="@(s == Model.SpeciesFilter)">@s</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary">Filter</button>
                <a asp-page="Index" class="btn btn-link">Clear</a>
            </div>
        </form>
    }

    <div class="card">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tag number</th>
                        <th>Species</th>
                        <th>Breed</th>
                        <th>Sex</th>
                        <th>Age</th>
                        <th>Farm</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Animals.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No animals found.</td></tr>
                    }
                    @foreach (var a in Model.Animals)
                    {
                        <tr>
                            <td><strong>@a.TagNumber</strong></td>
                            <td>@a.Species</td>
                            <td>@(a.Breed ?? "—")</td>
                            <td>@(a.Sex ?? "—")</td>
                            <td>@Age(a.DateOfBirth)</td>
                            <td>@a.FarmName</td>
                            <td class="text-end text-nowrap">
                                <a asp-page="/Animals/Details" asp-route-id="@a.AnimalId"
                                   class="btn btn-sm btn-outline-secondary">View</a>
                                <button type="button" class="btn btn-sm btn-outline-primary edit-btn"
                                        data-id="@a.AnimalId"
                                        data-farm="@a.FarmId"
                                        data-species="@a.Species"
                                        data-tag="@a.TagNumber"
                                        data-breed="@a.Breed"
                                        data-sex="@a.Sex"
                                        data-dob="@(a.DateOfBirth?.ToString("yyyy-MM-dd"))">
                                    Edit
                                </button>
                                @if (a.RecordCount > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled
                                            title="This animal has health records, vaccinations or appointments">
                                        Delete
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger delete-btn"
                                            data-id="@a.AnimalId" data-tag="@a.TagNumber">
                                        Delete
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ---------- Add / Edit modal ---------- *@
    <div class="modal fade" id="animalModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="Save" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="animalModalTitle">Register animal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Input.AnimalId" />

                    <div class="mb-3">
                        <label asp-for="Input.FarmId" class="form-label"></label>
                        <select asp-for="Input.FarmId" asp-items="Model.FarmOptions" class="form-select"></select>
                        <span asp-validation-for="Input.FarmId" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Species" class="form-label"></label>
                            <select asp-for="Input.Species" class="form-select">
                                <option value="">-- Select --</option>
                                @foreach (var s in IndexModel.SpeciesList)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                            <span asp-validation-for="Input.Species" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.TagNumber" class="form-label"></label>
                            <input asp-for="Input.TagNumber" class="form-control" />
                            <span asp-validation-for="Input.TagNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Breed" class="form-label"></label>
                            <input asp-for="Input.Breed" class="form-control" />
                            <span asp-validation-for="Input.Breed" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Sex" class="form-label"></label>
                            <select asp-for="Input.Sex" class="form-select">
                                <option value="">Unknown</option>
                                @foreach (var s in IndexModel.SexList)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.DateOfBirth" class="form-label"></label>
                        <input asp-for="Input.DateOfBirth" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    @* ---------- Delete confirmation modal ---------- *@
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="Delete" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete animal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="deleteAnimalId" />
                    Are you sure you want to delete animal <strong id="deleteAnimalTag"></strong>?
                    This cannot be undone.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
}

@* ======================= VETERINARIAN VIEW ======================= *@
else
{
    <h2 class="mb-3">Find an Animal</h2>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-6">
            <input name="Search" value="@Model.Search" class="form-control"
                   placeholder="Enter a tag number (full or partial)" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (string.IsNullOrWhiteSpace(Model.Search))
    {
        <div class="text-muted">Search by tag number to find an animal and view its health history.</div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tag number</th>
                            <th>Species</th>
                            <th>Breed</th>
                            <th>Sex</th>
                            <th>Age</th>
                            <th>Owner</th>
                            <th>Farm</th>
                            <th>District</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Animals.Count == 0)
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No animals match that tag number.</td></tr>
                        }
                        @foreach (var a in Model.Animals)
                        {
                            <tr>
                                <td><strong>@a.TagNumber</strong></td>
                                <td>@a.Species</td>
                                <td>@(a.Breed ?? "—")</td>
                                <td>@(a.Sex ?? "—")</td>
                                <td>@Age(a.DateOfBirth)</td>
                                <td>@a.OwnerName</td>
                                <td>@a.FarmName</td>
                                <td>@a.District</td>
                                <td class="text-end">
                                    <a asp-page="/Animals/Details" asp-route-id="@a.AnimalId"
                                       class="btn btn-sm btn-primary">Open</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.IsFarmer)
    {
        <script>
            const animalModal = new bootstrap.Modal(document.getElementById('animalModal'));
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

            const f = {
                id: document.getElementById('Input_AnimalId'),
                farm: document.getElementById('Input_FarmId'),
                species: document.getElementById('Input_Species'),
                tag: document.getElementById('Input_TagNumber'),
                breed: document.getElementById('Input_Breed'),
                sex: document.getElementById('Input_Sex'),
                dob: document.getElementById('Input_DateOfBirth')
            };

            const addBtn = document.getElementById('addAnimalBtn');
            if (addBtn) {
                addBtn.addEventListener('click', () => {
                    f.id.value = 0;
                    f.species.value = '';
                    f.tag.value = '';
                    f.breed.value = '';
                    f.sex.value = '';
                    f.dob.value = '';
                    // pre-select the farm currently being filtered, otherwise the first farm
                    const filter = new URLSearchParams(location.search).get('FarmFilter');
                    f.farm.value = filter && filter !== '0' ? filter : f.farm.options[0].value;
                    document.getElementById('animalModalTitle').textContent = 'Register animal';
                    animalModal.show();
                });
            }

            document.querySelectorAll('.edit-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    f.id.value = btn.dataset.id;
                    f.farm.value = btn.dataset.farm;
                    f.species.value = btn.dataset.species;
                    f.tag.value = btn.dataset.tag;
                    f.breed.value = btn.dataset.breed || '';
                    f.sex.value = btn.dataset.sex || '';
                    f.dob.value = btn.dataset.dob || '';
                    document.getElementById('animalModalTitle').textContent = 'Edit animal';
                    animalModal.show();
                });
            });

            document.querySelectorAll('.delete-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.getElementById('deleteAnimalId').value = btn.dataset.id;
                    document.getElementById('deleteAnimalTag').textContent = btn.dataset.tag;
                    deleteModal.show();
                });
            });

            @if (Model.ShowModal)
                {
                    <text>
                        document.getElementById('animalModalTitle').textContent =
                    f.id.value > 0 ? 'Edit animal' : 'Register animal';
                    animalModal.show();
                </text>
            }
        </script>
    }
}