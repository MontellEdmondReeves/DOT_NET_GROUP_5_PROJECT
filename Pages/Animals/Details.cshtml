@page "{id:int}"
@using Livestock_Health_App.Pages.Animals
@model Livestock_Health_App.Pages.Animals.DetailsModel
@{
    ViewData["Title"] = "Animal " + Model.Animal.TagNumber;

    string Age(DateTime? dob)
    {
        if (dob == null) return "—";
        var today = DateTime.Today;
        int months = (today.Year - dob.Value.Year) * 12 + today.Month - dob.Value.Month;
        if (today.Day < dob.Value.Day) months--;
        if (months < 0) months = 0;
        return months >= 12 ? $"{months / 12} yr {months % 12} mo" : $"{months} mo";
    }

    string CaseBadge(string? s) => s switch
    {
        "Resolved" => "bg-success",
        "Under Treatment" => "bg-warning text-dark",
        "Open" => "bg-danger",
        _ => "bg-secondary"
    };

    string ApptBadge(string s) => s switch
    {
        "Pending" => "bg-warning text-dark",
        "Accepted" => "bg-success",
        "Completed" => "bg-primary",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };

    (string, string) VaccStatus(VaccinationEntry v)
    {
        if (!v.IsLatest) return ("Previous dose", "bg-light text-dark");
        if (v.NextDueDate == null) return ("Completed", "bg-secondary");
        var days = (v.NextDueDate.Value.Date - DateTime.Today).Days;
        if (days < 0) return ("Overdue", "bg-danger");
        if (days <= 14) return ("Due soon", "bg-warning text-dark");
        return ("Up to date", "bg-success");
    }
}

<div class="mb-3">
    <a asp-page="Index" class="text-decoration-none">&larr; Back to animals</a>
</div>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">
        @ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @err <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ---------- Animal summary ---------- *@
<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1">@Model.Animal.TagNumber</h2>
                <span class="badge bg-secondary">@Model.Animal.Species</span>
            </div>
            @if (Model.IsFarmer)
            {
                <a asp-page="/Vets/Index" class="btn btn-primary">Request a vet visit</a>
            }
        </div>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Breed</dt>
                    <dd class="col-sm-8">@(Model.Animal.Breed ?? "—")</dd>
                    <dt class="col-sm-4">Sex</dt>
                    <dd class="col-sm-8">@(Model.Animal.Sex ?? "—")</dd>
                    <dt class="col-sm-4">Born</dt>
                    <dd class="col-sm-8">
                        @(Model.Animal.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")
                        @if (Model.Animal.DateOfBirth != null)
                        {
                            <span class="text-muted">(@Age(Model.Animal.DateOfBirth))</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Farm</dt>
                    <dd class="col-sm-8">@Model.Animal.FarmName</dd>
                    <dt class="col-sm-4">Location</dt>
                    <dd class="col-sm-8">@Model.Animal.Village, @Model.Animal.Cell, @Model.Animal.Sector, @Model.Animal.District</dd>
                    @if (Model.IsVet)
                    {
                        <dt class="col-sm-4">Owner</dt>
                        <dd class="col-sm-8">
                            @Model.Animal.OwnerName
                            @if (!string.IsNullOrWhiteSpace(Model.Animal.OwnerPhone))
                            {
                                <span> &middot; <a href="tel:@Model.Animal.OwnerPhone">@Model.Animal.OwnerPhone</a></span>
                            }
                        </dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

@* ---------- Tabs ---------- *@
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(Model.Tab == "records" ? "active" : "")" data-bs-toggle="tab"
                data-bs-target="#paneRecords" type="button">
            Health history <span class="badge bg-light text-dark">@Model.Records.Count</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(Model.Tab == "vaccinations" ? "active" : "")" data-bs-toggle="tab"
                data-bs-target="#paneVaccinations" type="button">
            Vaccinations <span class="badge bg-light text-dark">@Model.Vaccinations.Count</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(Model.Tab == "appointments" ? "active" : "")" data-bs-toggle="tab"
                data-bs-target="#paneAppointments" type="button">
            Appointments <span class="badge bg-light text-dark">@Model.Appointments.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content">

    @* ================= HEALTH HISTORY ================= *@
    <div class="tab-pane fade @(Model.Tab == "records" ? "show active" : "")" id="paneRecords">
        @if (Model.IsVet)
        {
            <div class="mb-3">
                <button type="button" class="btn btn-primary" id="addRecordBtn">+ Add health record</button>
            </div>
        }
        <div class="card">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Diagnosis</th>
                            <th>Treatment</th>
                            <th>Status</th>
                            <th>Veterinarian</th>
                            @if (Model.IsVet)
                            {
                                <th class="text-end"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Records.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No health records yet.</td></tr>
                        }
                        @foreach (var rec in Model.Records)
                        {
                            <tr>
                                <td class="text-nowrap">@rec.Date.ToString("dd MMM yyyy")</td>
                                <td>
                                    <strong>@(rec.Diagnosis ?? "—")</strong>
                                    @if (!string.IsNullOrWhiteSpace(rec.Description))
                                    {
                                        <div class="small text-muted">@rec.Description</div>
                                    }
                                </td>
                                <td>@(rec.Treatment ?? "—")</td>
                                <td><span class="badge @CaseBadge(rec.CaseStatus)">@(rec.CaseStatus ?? "—")</span></td>
                                <td>@(rec.VetName ?? "—")</td>
                                @if (Model.IsVet)
                                {
                                    <td class="text-end">
                                        @if (rec.VetId == Model.CurrentUserId)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary edit-record-btn"
                                                    data-id="@rec.RecordId"
                                                    data-diagnosis="@rec.Diagnosis"
                                                    data-treatment="@rec.Treatment"
                                                    data-status="@rec.CaseStatus"
                                                    data-description="@rec.Description">
                                                Edit
                                            </button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ================= VACCINATIONS ================= *@
    <div class="tab-pane fade @(Model.Tab == "vaccinations" ? "show active" : "")" id="paneVaccinations">
        @if (Model.IsVet)
        {
            <div class="mb-3">
                <button type="button" class="btn btn-primary" id="addVaccBtn">+ Register vaccination</button>
            </div>
        }
        <div class="card">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Vaccine</th>
                            <th>Date given</th>
                            <th>Next due</th>
                            <th>Status</th>
                            @if (Model.IsVet)
                            {
                                <th class="text-end"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Vaccinations.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No vaccinations recorded.</td></tr>
                        }
                        @foreach (var v in Model.Vaccinations)
                        {
                            var (statusText, statusClass) = VaccStatus(v);
                            <tr>
                                <td><strong>@v.VaccineName</strong></td>
                                <td>@v.VaccinationDate.ToString("dd MMM yyyy")</td>
                                <td>@(v.NextDueDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td><span class="badge @statusClass">@statusText</span></td>
                                @if (Model.IsVet)
                                {
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-primary edit-vacc-btn"
                                                data-id="@v.Id"
                                                data-name="@v.VaccineName"
                                                data-date="@v.VaccinationDate.ToString("yyyy-MM-dd")"
                                                data-next="@(v.NextDueDate?.ToString("yyyy-MM-dd"))">
                                            Edit
                                        </button>
                                        <form method="post" asp-page-handler="DeleteVaccination"
                                              asp-route-id="@Model.Animal.AnimalId" class="d-inline"
                                              onsubmit="return confirm('Delete this vaccination entry?');">
                                            <input type="hidden" name="vaccinationId" value="@v.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ================= APPOINTMENTS ================= *@
    <div class="tab-pane fade @(Model.Tab == "appointments" ? "show active" : "")" id="paneAppointments">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date and time</th>
                            <th>Veterinarian</th>
                            <th>Reason</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Appointments.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No appointments for this animal.</td></tr>
                        }
                        @foreach (var a in Model.Appointments)
                        {
                            <tr>
                                <td class="text-nowrap">@a.Date.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@a.VetName</td>
                                <td>@(string.IsNullOrWhiteSpace(a.Detail) ? "—" : a.Detail)</td>
                                <td><span class="badge @ApptBadge(a.Status)">@a.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (Model.IsVet)
{
    @* ============ Health record modal ============ *@
    <div class="modal fade" id="recordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="SaveRecord" asp-route-id="@Model.Animal.AnimalId" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="recordModalTitle">Add health record</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Record.RecordId" />

                    <div class="mb-3">
                        <label asp-for="Record.Diagnosis" class="form-label"></label>
                        <input asp-for="Record.Diagnosis" class="form-control" />
                        <span asp-validation-for="Record.Diagnosis" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Record.Treatment" class="form-label"></label>
                        <input asp-for="Record.Treatment" class="form-control" />
                        <span asp-validation-for="Record.Treatment" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Record.CaseStatus" class="form-label"></label>
                        <select asp-for="Record.CaseStatus" class="form-select">
                            @foreach (var s in DetailsModel.CaseStatuses)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Record.Description" class="form-label"></label>
                        <textarea asp-for="Record.Description" class="form-control" rows="3" maxlength="500"
                                  placeholder="Symptoms, observations, follow-up advice"></textarea>
                        <span asp-validation-for="Record.Description" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    @* ============ Vaccination modal ============ *@
    <div class="modal fade" id="vaccModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="SaveVaccination" asp-route-id="@Model.Animal.AnimalId" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="vaccModalTitle">Register vaccination</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Vaccination.VaccinationId" />

                    <div class="mb-3">
                        <label asp-for="Vaccination.VaccineName" class="form-label"></label>
                        <input asp-for="Vaccination.VaccineName" class="form-control" list="vaccineList" />
                        <datalist id="vaccineList">
                            <option value="Foot and Mouth Disease"></option>
                            <option value="Lumpy Skin Disease"></option>
                            <option value="Brucellosis"></option>
                            <option value="Anthrax"></option>
                            <option value="Black Quarter"></option>
                            <option value="Rabies"></option>
                            <option value="Peste des Petits Ruminants (PPR)"></option>
                            <option value="Newcastle Disease"></option>
                            <option value="Gumboro (IBD)"></option>
                            <option value="Fowl Pox"></option>
                        </datalist>
                        <span asp-validation-for="Vaccination.VaccineName" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Vaccination.VaccinationDate" class="form-label"></label>
                            <input asp-for="Vaccination.VaccinationDate" class="form-control"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="Vaccination.VaccinationDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Vaccination.NextDueDate" class="form-label"></label>
                            <input asp-for="Vaccination.NextDueDate" class="form-control" />
                            <span asp-validation-for="Vaccination.NextDueDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.IsVet)
    {
        <script>
            const recordModal = new bootstrap.Modal(document.getElementById('recordModal'));
            const vaccModal = new bootstrap.Modal(document.getElementById('vaccModal'));
            const today = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);

            const r = {
                id: document.getElementById('Record_RecordId'),
                diagnosis: document.getElementById('Record_Diagnosis'),
                treatment: document.getElementById('Record_Treatment'),
                status: document.getElementById('Record_CaseStatus'),
                description: document.getElementById('Record_Description')
            };
            const v = {
                id: document.getElementById('Vaccination_VaccinationId'),
                name: document.getElementById('Vaccination_VaccineName'),
                date: document.getElementById('Vaccination_VaccinationDate'),
                next: document.getElementById('Vaccination_NextDueDate')
            };

            // ----- health records -----
            document.getElementById('addRecordBtn').addEventListener('click', () => {
                r.id.value = 0;
                r.diagnosis.value = '';
                r.treatment.value = '';
                r.status.value = 'Open';
                r.description.value = '';
                document.getElementById('recordModalTitle').textContent = 'Add health record';
                recordModal.show();
            });

            document.querySelectorAll('.edit-record-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    r.id.value = btn.dataset.id;
                    r.diagnosis.value = btn.dataset.diagnosis || '';
                    r.treatment.value = btn.dataset.treatment || '';
                    r.status.value = btn.dataset.status || 'Open';
                    r.description.value = btn.dataset.description || '';
                    document.getElementById('recordModalTitle').textContent = 'Edit health record';
                    recordModal.show();
                });
            });

            // ----- vaccinations -----
            document.getElementById('addVaccBtn').addEventListener('click', () => {
                v.id.value = 0;
                v.name.value = '';
                v.date.value = today;
                v.next.value = '';
                document.getElementById('vaccModalTitle').textContent = 'Register vaccination';
                vaccModal.show();
            });

            document.querySelectorAll('.edit-vacc-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    v.id.value = btn.dataset.id;
                    v.name.value = btn.dataset.name;
                    v.date.value = btn.dataset.date;
                    v.next.value = btn.dataset.next || '';
                    document.getElementById('vaccModalTitle').textContent = 'Edit vaccination';
                    vaccModal.show();
                });
            });

            // Reopen the right form if the server rejected it
            @if (Model.ShowRecordModal)
                {
                    <text>
                        document.getElementById('recordModalTitle').textContent =
                    r.id.value > 0 ? 'Edit health record' : 'Add health record';
                    recordModal.show();
                </text>
            }
                @if (Model.ShowVaccModal)
                {
                    <text>
                        document.getElementById('vaccModalTitle').textContent =
                    v.id.value > 0 ? 'Edit vaccination' : 'Register vaccination';
                    vaccModal.show();
                </text>
            }
        </script>
    }
}