@page
@model Livestock_Health_App.Pages.Farms.IndexModel
@{
    ViewData["Title"] = "My Farms";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">My Farms</h2>
    <button type="button" class="btn btn-primary" id="addFarmBtn">+ Add farm</button>
</div>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">
        @ok
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Farm name</th>
                    <th>District</th>
                    <th>Sector</th>
                    <th>Cell</th>
                    <th>Village</th>
                    <th class="text-center">Animals</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Farms.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            You have not registered any farms yet. Click "Add farm" to start.
                        </td>
                    </tr>
                }
                @foreach (var f in Model.Farms)
                {
                    <tr>
                        <td><strong>@f.FarmName</strong></td>
                        <td>@f.District</td>
                        <td>@f.Sector</td>
                        <td>@f.Cell</td>
                        <td>@f.Village</td>
                        <td class="text-center"><span class="badge bg-secondary">@f.AnimalCount</span></td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary edit-btn"
                                    data-id="@f.FarmId"
                                    data-name="@f.FarmName"
                                    data-district="@f.District"
                                    data-sector="@f.Sector"
                                    data-cell="@f.Cell"
                                    data-village="@f.Village">
                                Edit
                            </button>

                            @if (f.AnimalCount > 0)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled
                                        title="Remove or move the animals on this farm first">
                                    Delete
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger delete-btn"
                                        data-id="@f.FarmId" data-name="@f.FarmName">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ============ Add / Edit modal ============ *@
<div class="modal fade" id="farmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Save" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="farmModalTitle">Add farm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Input.FarmId" />

                <div class="mb-3">
                    <label asp-for="Input.FarmName" class="form-label"></label>
                    <input asp-for="Input.FarmName" class="form-control" />
                    <span asp-validation-for="Input.FarmName" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.District" class="form-label"></label>
                        <input asp-for="Input.District" class="form-control" />
                        <span asp-validation-for="Input.District" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Sector" class="form-label"></label>
                        <input asp-for="Input.Sector" class="form-control" />
                        <span asp-validation-for="Input.Sector" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Cell" class="form-label"></label>
                        <input asp-for="Input.Cell" class="form-control" />
                        <span asp-validation-for="Input.Cell" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Village" class="form-label"></label>
                        <input asp-for="Input.Village" class="form-control" />
                        <span asp-validation-for="Input.Village" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@* ============ Delete confirmation modal ============ *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Delete" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete farm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" id="deleteFarmId" />
                Are you sure you want to delete <strong id="deleteFarmName"></strong>?
                This cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const farmModal = new bootstrap.Modal(document.getElementById('farmModal'));
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        const f = {
            id: document.getElementById('Input_FarmId'),
            name: document.getElementById('Input_FarmName'),
            district: document.getElementById('Input_District'),
            sector: document.getElementById('Input_Sector'),
            cell: document.getElementById('Input_Cell'),
            village: document.getElementById('Input_Village')
        };

        // Add
        document.getElementById('addFarmBtn').addEventListener('click', () => {
            Object.values(f).forEach(el => el.value = '');
            f.id.value = 0;
            document.getElementById('farmModalTitle').textContent = 'Add farm';
            farmModal.show();
        });

        // Edit
        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                f.id.value = btn.dataset.id;
                f.name.value = btn.dataset.name;
                f.district.value = btn.dataset.district;
                f.sector.value = btn.dataset.sector;
                f.cell.value = btn.dataset.cell;
                f.village.value = btn.dataset.village;
                document.getElementById('farmModalTitle').textContent = 'Edit farm';
                farmModal.show();
            });
        });

        // Delete
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('deleteFarmId').value = btn.dataset.id;
                document.getElementById('deleteFarmName').textContent = btn.dataset.name;
                deleteModal.show();
            });
        });

        // Reopen the form if the server rejected it (validation errors)
        @if (Model.ShowModal)
            {
                <text>
                    document.getElementById('farmModalTitle').textContent =
                f.id.value > 0 ? 'Edit farm' : 'Add farm';
                farmModal.show();
            </text>
        }
    </script>
}