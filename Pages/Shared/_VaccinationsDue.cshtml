@model List<Livestock_Health_App.Pages.VaccinationRow>

<div class="card h-100">
    <div class="card-header d-flex justify-content-between">
        <strong>Vaccinations due (next 14 days)</strong>
        <a asp-page="/Vaccinations/Index" class="small">View all</a>
    </div>
    @if (Model.Count == 0)
    {
        <div class="card-body text-muted">No vaccinations due.</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var v in Model)
            {
                var overdue = v.DueDate.Date < DateTime.Today;
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div>
                        <div>@v.Species &middot; <strong>@v.TagNumber</strong></div>
                        <small class="text-muted">@v.VaccineName</small>
                    </div>
                    <div class="text-end">
                        <div>@v.DueDate.ToString("dd MMM yyyy")</div>
                        @if (overdue)
                        {
                            <span class="badge bg-danger">Overdue</span>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>