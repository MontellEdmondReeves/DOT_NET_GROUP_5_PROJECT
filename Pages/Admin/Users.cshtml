@page
@model Livestock_Health_App.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Manage Users";

    string RoleBadge(string role) => role switch
    {
        "Admin" => "bg-dark",
        "Veterinarian" => "bg-info text-dark",
        _ => "bg-success"
    };
}

<h2 class="mb-3">Manage Users</h2>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">
        @ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @err <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ---------- Filter tabs ---------- *@
<ul class="nav nav-pills mb-3">
    @foreach (var f in Livestock_Health_App.Pages.Admin.UsersModel.Filters)
    {
        Model.Counts.TryGetValue(f, out var count);
        var label = f switch { "Unverified" => "Vets awaiting verification", "Veterinarian" => "Veterinarians", "Farmer" => "Farmers", "Admin" => "Admins", _ => "All" };
        <li class="nav-item">
            <a class="nav-link @(Model.Filter == f ? "active" : "")"
               asp-page="Users" asp-route-Filter="@f" asp-route-Search="@Model.Search">
                @label
                <span class="badge @(f == "Unverified" && count > 0 ? "bg-warning text-dark" : "bg-light text-dark")">@count</span>
            </a>
        </li>
    }
</ul>

@* ---------- Search ---------- *@
<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="Filter" value="@Model.Filter" />
    <div class="col-md-5">
        <input name="Search" value="@Model.Search" class="form-control" placeholder="Search by name or email" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-page="Users" asp-route-Filter="@Model.Filter" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Clinic</th>
                    <th>Verification</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No users found.</td></tr>
                }
                @foreach (var u in Model.Users)
                {
                    var isSelf = u.UserId == Model.CurrentUserId;
                    <tr>
                        <td>
                            <strong>@u.FullName</strong>
                            @if (isSelf)
                            {
                                <span class="badge bg-secondary ms-1">You</span>
                            }
                        </td>
                        <td>@u.Email</td>
                        <td>@(u.Phone ?? "—")</td>
                        <td><span class="badge @RoleBadge(u.Role)">@u.Role</span></td>
                        <td>@(u.Role == "Veterinarian" ? (u.ClinicName ?? "—") : "")</td>
                        <td>
                            @if (u.Role == "Veterinarian")
                            {
                                @if (u.IsVerified)
                                {
                                    <span class="badge bg-success">Verified</span>
                                }
                                else
                                {

                                    <span class="badge bg-warning text-dark">Unverified</span>
                                }
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (u.Role == "Veterinarian")
                            {
                                @if (!u.IsVerified)
                                {
                                    <form method="post" asp-page-handler="Verify" asp-route-id="@u.UserId"
                                          asp-route-Filter="@Model.Filter" asp-route-Search="@Model.Search" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success">Verify</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Revoke" asp-route-id="@u.UserId"
                                          asp-route-Filter="@Model.Filter" asp-route-Search="@Model.Search" class="d-inline"
                                          onsubmit="return confirm('Revoke verification for @u.FullName? They will no longer appear in the vet search.');">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Revoke</button>
                                    </form>
                                }
                            }

                            <button type="button" class="btn btn-sm btn-outline-primary edit-btn"
                                    data-id="@u.UserId"
                                    data-name="@u.FullName"
                                    data-phone="@u.Phone"
                                    data-clinic="@u.ClinicId"
                                    data-email="@u.Email"
                                    data-role="@u.Role">
                                Edit
                            </button>

                            @if (isSelf)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled
                                        title="You cannot delete your own account">
                                    Delete
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger delete-btn"
                                        data-id="@u.UserId" data-name="@u.FullName">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ============ Edit modal ============ *@
<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Save"
              asp-route-Filter="@Model.Filter" asp-route-Search="@Model.Search" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit user</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Input.UserId" />
                <input type="hidden" asp-for="Input.Email" />
                <input type="hidden" asp-for="Input.Role" />

                <p class="text-muted small mb-3">
                    <span id="userEmailText"></span> &middot; <span id="userRoleText"></span>
                </p>

                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label"></label>
                    <input asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Phone" class="form-label"></label>
                    <input asp-for="Input.Phone" class="form-control" />
                    <span asp-validation-for="Input.Phone" class="text-danger"></span>
                </div>
                <div class="mb-3" id="clinicGroup" style="display:none">
                    <label asp-for="Input.ClinicId" class="form-label"></label>
                    <select asp-for="Input.ClinicId" asp-items="Model.ClinicOptions" class="form-select">
                        <option value="">-- Select clinic --</option>
                    </select>
                    <span asp-validation-for="Input.ClinicId" class="text-danger"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@* ============ Delete confirmation modal ============ *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Delete"
              asp-route-Filter="@Model.Filter" asp-route-Search="@Model.Search" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete user</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" id="deleteUserId" />
                Are you sure you want to delete <strong id="deleteUserName"></strong>?
                This cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const userModal = new bootstrap.Modal(document.getElementById('userModal'));
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        const f = {
            id: document.getElementById('Input_UserId'),
            name: document.getElementById('Input_FullName'),
            phone: document.getElementById('Input_Phone'),
            clinic: document.getElementById('Input_ClinicId'),
            email: document.getElementById('Input_Email'),
            role: document.getElementById('Input_Role')
        };

        // show the read-only email/role text, and the clinic field for vets only
        function syncModal() {
            document.getElementById('userEmailText').textContent = f.email.value;
            document.getElementById('userRoleText').textContent = f.role.value;
            document.getElementById('clinicGroup').style.display =
                f.role.value === 'Veterinarian' ? 'block' : 'none';
        }

        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                f.id.value = btn.dataset.id;
                f.name.value = btn.dataset.name;
                f.phone.value = btn.dataset.phone || '';
                f.clinic.value = btn.dataset.clinic || '';
                f.email.value = btn.dataset.email;
                f.role.value = btn.dataset.role;
                syncModal();
                userModal.show();
            });
        });

        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('deleteUserId').value = btn.dataset.id;
                document.getElementById('deleteUserName').textContent = btn.dataset.name;
                deleteModal.show();
            });
        });

        // Reopen the form if the server rejected it
        @if (Model.ShowModal)
            {
                <text>syncModal(); userModal.show(); </text>
        }
    </script>
}